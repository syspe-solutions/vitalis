DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=TRUE
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=America/Recife
DB_NAME=db.sqlite3

# Email (opcional). Deixe DJANGO_EMAIL_HOST em branco para usar o backend de
# console (e-mails impressos no terminal do runserver — bom para testar o MVP
# sem SMTP). Preencha para enviar e-mails de verdade.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=TRUE
DJANGO_EMAIL_USE_SSL=FALSE
DJANGO_DEFAULT_FROM_EMAIL=no-reply@vitalis.local
